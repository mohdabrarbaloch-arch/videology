# Copy to .env and fill in your keys.

# Database file path (Railway: mount a volume at /data and keep this default)
DATABASE_URL="file:/data/app.db"

# Auth secret - change to a long random string
JWT_SECRET="change-me-to-a-long-random-string"

# AI - can be OpenAI or OpenRouter (OpenRouter keys start with sk-or-v1-)
OPENAI_API_KEY=""

# Transcription (GROQ is recommended - fast whisper-large-v3-turbo)
GROQ_API_KEY=""

# Optional overrides (defaults work locally, use these on Railway with a /data volume)
# UPLOADS_DIR="/data/uploads"
# CLIPS_DIR="/data/clips"
# WORK_DIR="/data/clips-work"
# THUMBNAIL_DIR="/data/thumbnails"
# TOOLS_DIR="/data/tools"
