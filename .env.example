# Copy to .env and fill in your keys.

# ------------------------------------------------------------------
# DEPLOYMENT: Vercel / Netlify (serverless)
# Serverless has NO persistent local disk, so you MUST configure
# Supabase (cloud Postgres + cloud storage) for the app to work.
# ------------------------------------------------------------------

# --- Supabase Database (Postgres) ---
# Create a Supabase project, then get the connection string from
# Project Settings > Database. Use the "Transaction pooler" connection
# string (pgbouncer port 6543) for serverless.
# Example:
# DATABASE_URL="postgresql://postgres.abcd:<password>@aws-0-region.pooler.supabase.com:6543/postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/videology"
# DIRECT_URL is the same connection on port 5432 (direct, no pooler).
# It's used by `prisma migrate` because the pooler blocks advisory locks.
# NOT required at runtime on Vercel (lib/db.ts only reads DATABASE_URL).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/videology"

# --- Supabase Storage (cloud mode: video/audio/clips/thumbnails) ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# --- AI (analysis, chat, quiz, thumbnails) ---
# Can be OpenAI or OpenRouter (OpenRouter keys start with sk-or-v1-)
OPENAI_API_KEY=""

# --- Transcription (GROQ recommended - fast whisper-large-v3-turbo) ---
GROQ_API_KEY=""

# --- Optional: Netlify builds download the linux yt-dlp binary automatically.
# Set your site URL so background functions can self-invoke. ---
# URL="https://your-site.netlify.app"

# ------------------------------------------------------------------
# ALTERNATIVE: Railway / Docker (persistent volume at /data)
# If deploying to Railway, set DATABASE_URL to SQLite at /data and
# the directory overrides below. Cloud storage variables above are not
# required when using a volume.
# ------------------------------------------------------------------
# DATABASE_URL="file:/data/app.db"
# UPLOADS_DIR="/data/uploads"
# CLIPS_DIR="/data/clips"
# WORK_DIR="/data/clips-work"
# THUMBNAIL_DIR="/data/thumbnails"
# TOOLS_DIR="/data/tools"
