# Copy to .env and fill in your keys.

# PostgreSQL database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/videology"

# Auth secret - change to a long random string (generate: openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"

# AI - can be OpenAI or OpenRouter (OpenRouter keys start with sk-or-v1-)
OPENAI_API_KEY=""

# Transcription (GROQ is recommended - fast whisper-large-v3-turbo)
GROQ_API_KEY=""

# Optional overrides — required when running in Docker with a volume at /data
UPLOADS_DIR="/data/uploads"
CLIPS_DIR="/data/clips"
WORK_DIR="/data/clips-work"
THUMBNAIL_DIR="/data/thumbnails"
TOOLS_DIR="/data/tools"
