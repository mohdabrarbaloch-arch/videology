generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Video {
  id           String   @id @default(uuid())
  title        String?
  source       String
  sourceType   String
  originalUrl  String?
  filePath     String?
  audioPath    String?
  thumbnailUrl String?
  duration     Float?
  status       String   @default("uploaded")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transcript   Transcript?
  analysis     Analysis?
  chatMessages ChatMessage[]
  quizzes      Quiz[]
}

model Transcript {
  id        String   @id @default(uuid())
  videoId   String   @unique
  language  String   @default("en")
  text      String
  segments  String
  createdAt DateTime @default(now())

  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Analysis {
  id              String   @id @default(uuid())
  videoId         String   @unique
  summary         String
  keyPoints       String
  topics          String
  chapters        String
  importantMoments String
  learningInsights String
  createdAt       DateTime @default(now())

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(uuid())
  videoId   String
  role      String
  content   String
  createdAt DateTime @default(now())

  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Quiz {
  id        String   @id @default(uuid())
  videoId   String
  title     String
  questions String
  score     Int?
  createdAt DateTime @default(now())

  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model ClipJob {
  id        String   @id @default(uuid())
  status    String   @default("queued")
  progress  String?
  error     String?
  params    Json?
  result    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
